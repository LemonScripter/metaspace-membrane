{
  "_metaspace_probe": "MS_PROBE_PROJECT_ROOT",
  "_candidate_path": "<workspace>/hooks.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import pathlib;pathlib.Path(r'{{TEMP}}/agy_fired_project_root.txt').write_text('fired')\""
          }
        ]
      }
    ]
  }
}