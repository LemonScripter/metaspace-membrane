# RATIFIED
# MetaSpace.Bio Engine Project — Agent (session) membrane constitution [template]
#
# HARD membrane for a Claude Code session. Enforcement: a PreToolUse hook in the harness
# (OUTSIDE the agent) — not self-discipline.
#
# {{PROJECT_ROOT}} is substituted by the installer / hook with the target project path.

CELL AgentSession {

  CAPABILITIES {
    # write ONLY inside the project directory
    FILESYSTEM write "{{PROJECT_ROOT}}/**";
    # read anywhere (so the agent can study any codebase)
    FILESYSTEM read  "**";
    # outbound network only to allowed hosts (edit for your project)
    NETWORK    out   "docs.anthropic.com", "docs.claude.com";
    # everything else: DENY (deny-by-default)
  }

  BASH_POLICY {
    # STRUCTURAL allowlist: only these programs may run (deny-by-default). The hook resolves
    # the real program names with a shell lexer, so obfuscation (quoting, ${IFS}, chaining,
    # substitution) cannot smuggle a non-allowlisted program past it; garbage fails closed.
    ALLOW "python", "python3", "pip", "pip3", "node", "npm", "npx", "pytest",
          "git", "cargo", "rustc", "tectonic", "bash", "sh",
          "ls", "cat", "echo", "cd", "mkdir", "cp", "mv", "touch",
          "grep", "find", "head", "tail", "wc", "sort", "test", "true", "false";
    # token-based denied invocations (defense-in-depth, even for allowlisted programs)
    DENY "git push";
    DENY "git reset --hard";
    DENY "rm -rf";
    DENY "mkfs";
  }

}
